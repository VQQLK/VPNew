<?xml version="1.0" encoding="utf-8"?>
<!--
  FIX: добавлен xmlns:app для атрибутов MaterialButton:
       app:cornerRadius, app:strokeColor, app:strokeWidth
       (android: namespace для этих атрибутов не работает)
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:background="#0D1117">

    <!-- Логотип / иконка -->
    <ImageView
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:src="@drawable/ic_vpn_lock"
        android:tint="#58A6FF"
        android:layout_marginBottom="24dp"
        android:contentDescription="VPN Lock Icon" />

    <!-- Заголовок -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MyVPN"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="#E6EDF3"
        android:letterSpacing="0.1"
        android:layout_marginBottom="8dp" />

    <!-- Статус -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="○ Отключено"
        android:textSize="16sp"
        android:textColor="#8B949E"
        android:layout_marginBottom="48dp" />

    <!-- Кнопка подключения (MaterialButton) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConnect"
        android:layout_width="220dp"
        android:layout_height="56dp"
        android:text="Подключить"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:backgroundTint="#238636"
        app:cornerRadius="28dp"
        android:layout_marginBottom="16dp" />

    <!-- Импорт профиля (MaterialButton outlined) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnImport"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="220dp"
        android:layout_height="48dp"
        android:text="Импорт config.json"
        android:textSize="14sp"
        android:textColor="#58A6FF"
        app:backgroundTint="#161B22"
        app:strokeColor="#30363D"
        app:strokeWidth="1dp"
        app:cornerRadius="24dp"
        android:layout_marginBottom="32dp" />

    <!-- IP адрес -->
    <TextView
        android:id="@+id/tvIp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#8B949E"
        android:fontFamily="monospace" />

</LinearLayout>
