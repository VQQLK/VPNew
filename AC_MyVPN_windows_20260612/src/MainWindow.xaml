<Window x:Class="MyVPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MyVPN" Height="480" Width="360"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="#0D1117">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="52"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="26"
                                Padding="10,0">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Width" Value="220"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#161B22"
                                CornerRadius="22"
                                BorderBrush="#30363D"
                                BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                    Orientation="Vertical">

            <!-- Icon -->
            <Viewbox Width="80" Height="80" Margin="0,0,0,20">
                <Canvas Width="24" Height="24">
                    <Path Fill="#58A6FF"
                          Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4z"/>
                </Canvas>
            </Viewbox>

            <!-- Title -->
            <TextBlock Text="MyVPN"
                       FontSize="30" FontWeight="Bold"
                       Foreground="#E6EDF3"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Status -->
            <TextBlock x:Name="TbStatus"
                       Text="○  Отключено"
                       FontSize="15"
                       Foreground="#8B949E"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,40"/>

            <!-- Connect button -->
            <Button x:Name="BtnConnect"
                    Style="{StaticResource PrimaryButton}"
                    Background="#238636"
                    Content="Подключить"
                    Click="BtnConnect_Click"
                    Margin="0,0,0,14"/>

            <!-- Import button -->
            <Button x:Name="BtnImport"
                    Style="{StaticResource SecondaryButton}"
                    Content="Импорт config.json"
                    Click="BtnImport_Click"
                    Margin="0,0,0,28"/>

            <!-- IP label -->
            <TextBlock x:Name="TbIp"
                       Text=""
                       FontSize="12"
                       FontFamily="Consolas"
                       Foreground="#8B949E"
                       HorizontalAlignment="Center"/>

            <!-- Log area -->
            <Border Background="#161B22" CornerRadius="8"
                    Margin="0,20,0,0" Width="300" Height="90">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TbLog"
                               Text=""
                               FontSize="11"
                               FontFamily="Consolas"
                               Foreground="#58A6FF"
                               Padding="10,8"
                               TextWrapping="Wrap"/>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </Grid>
</Window>
